# Copie ce fichier en .env.local et remplis les valeurs (voir README).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Adresse(s) e-mail Google autorisée(s) à se connecter, séparées par des virgules.
ALLOWED_EMAILS=ton.adresse@gmail.com

# Optionnel : lecture automatique des documents. Côté serveur uniquement, jamais NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optionnel : Google Agenda (voir README, section « Google Agenda »). Côté serveur uniquement.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
